{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "types": ["node", "vitest/globals"],
        "allowJs": false,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "allowImportingTsExtensions": true,
        "paths": {
            "@/*": ["./src/*"],
            "@lib/*": ["./src/lib/*"],
            "@components/*": ["./src/components/*"]
        }
    },
    "include": ["types/**/*.d.ts", "src/**/*", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts", "vitest.config.js"],
    "exclude": ["node_modules", "dist", "css", "tests/**/*.js", "tests/**/*.mjs", "tests/**/*.cjs"]
}

DirectoryIndex index.html

RedirectMatch 301 ^/semantic-demo/?$ https://mccullough.cloud/semantic-demo/case-study.html

# ── Block development artifacts ──────────────────────────────────────
# Source maps
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Local debug bundle
<FilesMatch "^bundle-debug\.js$">
    Require all denied
</FilesMatch>

# Package manifests and config
<FilesMatch "^(package\.json|package-lock\.json|eslint\.config\.js|\.prettierrc)$">
    Require all denied
</FilesMatch>

# Backup files
<FilesMatch "\.bak-">
    Require all denied
</FilesMatch>

# Block node_modules and reports directories
RewriteEngine On
RewriteRule ^node_modules/ - [F,L]
RewriteRule ^reports/ - [F,L]

# ── Compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache control ────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: short cache (5 min) so deploys propagate quickly
    ExpiresByType text/html "access plus 5 minutes"
    # CSS/JS: medium cache (1 day) — cache-bust with ?v= query strings
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    # Images/video: long cache (30 days)
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"
    # Data: medium cache (1 day)
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/gzip "access plus 1 day"
</IfModule>

# ── Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

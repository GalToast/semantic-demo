DirectoryIndex index.html

RedirectMatch 301 ^/semantic-demo/?$ https://mccullough.cloud/semantic-demo/case-study.html

# ── Block development artifacts ──────────────────────────────────────
# Source maps
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Local debug bundle
<FilesMatch "^bundle-debug\.js$">
    Require all denied
</FilesMatch>

# Package manifests and config
<FilesMatch "^(package\.json|package-lock\.json|eslint\.config\.js|\.prettierrc)$">
    Require all denied
</FilesMatch>

# Backup files
<FilesMatch "\.bak-">
    Require all denied
</FilesMatch>

# Block development and legacy directories
RewriteEngine On
# backups/: defense-in-depth — deploy backups are now outside public_html
# (DEPLOY_BACKUP_DIR default: /home/u741831384/backups/semantic-demo/).
# This rule blocks any lingering old backup dirs under the web root.
RewriteRule ^backups/ - [F,L]
RewriteRule ^node_modules/ - [F,L]
RewriteRule ^reports/ - [F,L]

# ── Compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache control ────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: short cache (5 min) so deploys propagate quickly
    ExpiresByType text/html "access plus 5 minutes"
    # CSS/JS: medium cache (1 day) — cache-bust with ?v= query strings
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    # Images/video: long cache (30 days)
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"
    # Data: medium cache (1 day)
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/gzip "access plus 1 day"
</IfModule>

# ── Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content-Security-Policy
    # Designed for the legacy shell (vector-explorer-polished.html):
    #   script-src: 'self' for dist/bundle.js + worker initiator;
    #              cdn.jsdelivr.net for three.js modules via importmap.
    #              The inline importmap is allowed by exact sha256 hash.
    #              No 'unsafe-inline' needed.
    #   style-src:  'unsafe-inline' required for SVG style="..." attributes
    #               and JS element.style.* assignments.
    #   font-src:   fonts.gstatic.com for Google Fonts WOFF2.
    #   img-src:    data: for inline SVG favicon.
    #   connect-src: api.open-meteo.com for weather widget (CORS fetch).
    #   worker-src: js/workers/data-worker.js via new Worker().
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'sha256-lGEOGKyonii9j2P4RYFKZhnwl8Yl+BS7clpvKExzXrM='; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.open-meteo.com; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; object-src 'none';"
</IfModule>

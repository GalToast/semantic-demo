DirectoryIndex index.html

RedirectMatch 301 ^/semantic-demo/?$ https://mccullough.cloud/semantic-demo/case-study.html

# ── Dual-URL normalization (2026-08) ──────────────────────────────────
# Legacy shell now redirects (308) to the canonical entry; same build.
Redirect 308 /semantic-demo/vector-explorer-polished.html /semantic-demo/index.html
# ── Block development artifacts ──────────────────────────────────────
# Source maps
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Local debug bundle
<FilesMatch "^bundle-debug\.js$">
    Require all denied
</FilesMatch>

# Package manifests and config
<FilesMatch "^(package\.json|package-lock\.json|eslint\.config\.js|\.prettierrc)$">
    Require all denied
</FilesMatch>

# Backup files
<FilesMatch "\.bak-">
    Require all denied
</FilesMatch>

# Block development and legacy directories
RewriteEngine On
# backups/: defense-in-depth — deploy backups are now outside public_html
# (DEPLOY_BACKUP_DIR default: /home/u741831384/backups/semantic-demo/).
# This rule blocks any lingering old backup dirs under the web root.
RewriteRule ^backups/ - [F,L]
RewriteRule ^node_modules/ - [F,L]
RewriteRule ^reports/ - [F,L]

# ── Compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache control ────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: short cache (5 min) so deploys propagate quickly
    ExpiresByType text/html "access plus 5 minutes"
    # CSS/JS: medium cache (1 day) — cache-bust with ?v= query strings
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    # Images/video: long cache (30 days)
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"
    # Data: medium cache (1 day)
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/gzip "access plus 1 day"
</IfModule>

# ── Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content-Security-Policy
    # Designed for the Vite-built shell (dist/svelte/index.html):
    #   script-src: 'self' for hashed module assets + https://unpkg.com (Leaflet runtime JS).
    #   style-src:  'self' + 'unsafe-inline' (inline <style> layer vars) + https://unpkg.com (Leaflet CSS).
    #   font-src:   'self' (self-hosted woff2 in fonts/; no Google Fonts CDN).
    #   img-src:    'self' + data: (inline SVG favicon) + https://*.basemaps.cartocdn.com (Leaflet tiles).
    #   connect-src: 'self' (api.php, data.dat) + https://api.open-meteo.com (weather).
    #   worker-src: 'self' (data-worker via new Worker(new URL(...))).
    #   No reranker hosted, so ai.api.nvidia.com is intentionally excluded.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self'; img-src 'self' data: https://*.basemaps.cartocdn.com; connect-src 'self' https://api.open-meteo.com; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; object-src 'none';"
</IfModule>

# ── Precompressed static assets (dist/assets/*.gz / *.br) ──────────────────
# Vite emits gzip+brotli twins for every hashed asset. Serve them directly
# (precompressed) instead of letting the server re-compress on the fly:
# keeps LCP payload bytes minimal on slow mobile links (measured 11.7s LCP
# is transfer-bound). Falls back to mod_deflate output only when neither
# twin exists.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # brotli twin (preferred)
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}\.br -f
    RewriteCond %{REQUEST_FILENAME} \.(js|css|json|svg|woff2|html|dat)$ [NC]
    RewriteRule ^(.*)$ $1.br [L,QSA]
    # gzip twin
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}\.gz -f
    RewriteCond %{REQUEST_FILENAME} \.(js|css|json|svg|woff2|html|dat)$ [NC]
    RewriteRule ^(.*)$ $1.gz [L,QSA]
</IfModule>
<IfModule mod_headers.c>
    # keep per-extension, per-encoding headers: correct &lt;Content-Encoding&gt;
    # (browsers fail modules on MIME/encoding mismatch) + Vary triples.
    <FilesMatch "\.br$">
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
        <FilesMatch "\.js\.br$"><Header set Content-Type application/javascript></FilesMatch>
        <FilesMatch "\.css\.br$"><Header set Content-Type text/css></FilesMatch>
        <FilesMatch "\.json\.br$"><Header set Content-Type application/json></FilesMatch>
        <FilesMatch "\.svg\.br$"><Header set Content-Type image/svg+xml></FilesMatch>
        <FilesMatch "\.woff2\.br$"><Header set Content-Type font/woff2></FilesMatch>
        <FilesMatch "\.dat\.br$"><Header set Content-Type application/octet-stream></FilesMatch>
        <FilesMatch "\.html\.br$"><Header set Content-Type text/html></FilesMatch>
    </FilesMatch>
    <FilesMatch "\.gz$">
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
        <FilesMatch "\.js\.gz$"><Header set Content-Type application/javascript></FilesMatch>
        <FilesMatch "\.css\.gz$"><Header set Content-Type text/css></FilesMatch>
        <FilesMatch "\.json\.gz$"><Header set Content-Type application/json></FilesMatch>
        <FilesMatch "\.svg\.gz$"><Header set Content-Type image/svg+xml></FilesMatch>
        <FilesMatch "\.woff2\.gz$"><Header set Content-Type font/woff2></FilesMatch>
        <FilesMatch "\.dat\.gz$"><Header set Content-Type application/octet-stream></FilesMatch>
        <FilesMatch "\.html\.gz$"><Header set Content-Type text/html></FilesMatch>
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    AddEncoding gzip .gz
    AddEncoding br   .br
</IfModule>

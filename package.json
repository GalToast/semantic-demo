{
  "name": "semantic-explorer",
  "version": "1.0.0",
  "description": "3D semantic business explorer for Montgomery County records.",
  "main": "eslint.config.js",
  "type": "module",
  "scripts": {
    "lint": "eslint \"{js,tests}/**/*.{js,ts}\" && eslint \"src/**/*.{ts,svelte}\" --max-warnings=9999",
    "lint:tests": "eslint \"tests/**/*.{js,ts}\" --no-warn-ignored",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:a11y:strict": "node scripts/audit-a11y.mjs --strict",
    "audit:a11y:json": "node scripts/audit-a11y.mjs --json",
    "lint:nav-mirror": "node scripts/ci-check-nav-mirror-pattern.mjs",
    "check:focus-gate": "node scripts/ci-check-focus-gate.mjs",
    "sg": "ast-grep",
    "mcp:recover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mcp-recover.ps1",
    "format": "prettier --write \"{js,tests}/**/*.{js,ts,css}\"",
    "check:shell": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/shell-contract-check.js && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-import-linkage-check.mjs",
    "check:manifest": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-manifest-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/package-script-targets-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-self-reference-check.mjs",
    "check:script-targets": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/package-script-targets-contract.mjs",
    "check:skills": "node scripts/check-skill-loads.mjs",
    "check:tdb-fidelity": "node scripts/tdb1-fidelity-ci.mjs",
    "check:dist-integrity": "node scripts/qa-deploy-preflight.mjs --dist-only",
    "check:journey": "node scripts/qa-journey-gate.mjs",
    "check:model-catalog": "node tests/model-catalog-sweep.mjs",
    "check:model-catalog-runtime": "node tests/model-catalog-reconcile-sweep.mjs",
    "models:canonical-catalog": "node scripts/build-model-catalog.mjs --write-projection",
    "models:verify-catalog": "node scripts/verify-model-catalog.mjs",
    "models:capability-status": "node scripts/build-model-capability-status.mjs --catalog=tmp/phone-model-parity/canonical-model-catalog.json --health=tmp/phone-model-health/latest.json --markdown",
    "models:reconcile-runtime": "node scripts/reconcile-model-catalog.mjs",
    "models:phone-health": "node scripts/phone-model-health.mjs --phone-router=http://127.0.0.1:18789 --limit=8 --markdown",
    "phone:deploy-catalog": "node scripts/deploy-phone-model-catalog.mjs",
    "check:cache": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/cache-buster-check.js",
    "check:config-topology": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/config-topology-env-contract.mjs",
    "check:ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-ownership-sweep.mjs",
    "check:tokens": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/design-token-sweep.mjs",
    "check:surface-styles": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-style-matrix-contract.mjs",
    "check:semantic-space": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/semantic-space-audit.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/semantic-thread-relationship-role-contract.mjs",
    "check:svelte": "svelte-check --workspace src --tsconfig tsconfig.json --diagnostic-sources svelte,css",
    "check": "npm run verify:syntax && npm run check:svelte && npm run build:svelte",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:ts-progress": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/ts-js-drift-contract.mjs --progress",
    "qa:server": "node scripts/qa-server.mjs start",
    "qa:server:ensure": "node scripts/qa-server.mjs ensure",
    "qa:server:stop": "node scripts/qa-server.mjs stop",
    "qa:android": "node scripts/qa-android.mjs",
    "qa:server:status": "node scripts/qa-server.mjs status",
    "qa:visual": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/visual-state-audit.mjs --headed",
    "qa:product-playthrough": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/product-playthrough-audit.mjs --headed",
    "qa:short-landscape": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/short-landscape-layout-contract.mjs && npx playwright test tests/short-landscape-contract.spec.js --browser=chromium --headed",
    "qa:short-landscape:transition": "npx playwright test tests/short-landscape-transition-ui-paths.spec.js --browser=chromium --workers=1 --headed",
    "qa:short-landscape:release": "npm run qa:short-landscape && npm run qa:short-landscape:transition",
    "qa:contract": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-contract-check.mjs --headed",
    "qa:contract:mobile-critical": "node scripts/qa.mjs contract --preset=mobile-critical --headed",
    "qa:scene-health": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/three-scene-playtest.mjs",
    "qa:paint-budget": "node tests/paint-metrics-gate.mjs",
    "qa:adversarial": "npx playwright test tests/polish-adversarial.spec.js --browser=chromium --headed",
    "qa:live-reset": "npx playwright test tests/live-reset-clear-demo-proof.spec.js --browser=chromium --headed",
    "qa:journey": "npx playwright test tests/journey/ tests/widget-journey-smoke.spec.js --browser=chromium --headed",
    "qa:journey:headless": "node scripts/qa-journey-headless.mjs",
    "qa:journey:smoke": "npx playwright test tests/widget-journey-smoke.spec.js --browser=chromium",
    "qa:journey:fresh": "npm run build && npm run qa:journey",
    "qa:3d": "SEMANTIC_USE_D3D11=1 PLAYWRIGHT_STRICT_FRESH=1 npx playwright test tests/3d-*.spec.js --browser=chromium --workers=1",
    "qa:3d:fresh": "npm run build && npm run qa:3d",
    "qa:mapview-placeholder": "npx playwright test tests/mapview-placeholder-journey.spec.js --browser=chromium",
    "report:artifacts": "node scripts/report-artifact-volume.js",
    "refresh:cache": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/cache-buster-check.js --fix",
    "build": "npm run build:svelte",
    "watch": "vite build --config vite.config.ts --watch",
    "serve": "node scripts/decompress-data-twins.mjs && php -S 127.0.0.1:8795 -t .",
    "check:bridges": "node scripts/check-bridge-references.mjs",
    "test:static": "npm run check:shell && npm run check:skills && npm run check:manifest && npm run check:cache && npm run check:config-topology && npm run check:bridges && npm run check:ownership && npm run check:tokens && npm run check:surface-styles && npm run check:semantic-space && npm run check:focus-gate && npm run typecheck",
    "test": "npm run test:static && node scripts/run-vitest.mjs run --config vitest.config.js",
    "test:fast": "npm run test:static",
    "test:contract": "node tests/run-all-contracts.js",
    "test:contract:core": "node tests/run-all-contracts.js --group=core",
    "test:contract:smoke": "node tests/run-all-contracts.js --group=smoke",
    "test:unit": "node scripts/run-vitest.mjs run --config vitest.config.js",
    "test:verify": "node scripts/verify-env.mjs",
    "test:verify:unit": "node scripts/verify-env.mjs --unit-only",
    "test:help": "node scripts/test-help.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "deploy:dryrun": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -DryRun",
    "test:visual": "npx tsx tests/visual-regression.test.ts",
    "test:a11y": "playwright test tests/integration/a11y-baseline.spec.js --browser=chromium",
    "test:svelte-migration": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/verify-svelte-migration.mjs",
    "dev:svelte": "vite --config vite.config.ts",
    "build:svelte": "node scripts/fetch-data-assets.mjs --if-missing && node scripts/build-minimized-enrichment.mjs && vite build --config vite.config.ts && npm run check:data-compression",
    "preview:svelte": "vite preview --config vite.config.ts",
    "git:hook:check": "node scripts/git-hooks/run-check.mjs",
    "git:hook:install": "node scripts/git-hooks/install.mjs",
    "git:hook:uninstall": "node scripts/git-hooks/install.mjs --remove",
    "sweep": "node scripts/tmp-ttl-sweep.mjs --apply --days=14 && node scripts/harness-sweep.mjs",
    "gate": "node scripts/smoke-gate.mjs",
    "verify:syntax": "node scripts/verify-syntax.mjs",
    "verify:3d-tests": "node scripts/verify-3d-test-admission.mjs",
    "check:param-prop": "node tests/param-property-loader-sweep.mjs",
    "check:data-compression": "node scripts/check-data-compression.mjs",
    "check:findings-witness": "node scripts/verify-findings-claims.mjs",
    "ci": "npm run verify:syntax && npm run check:svelte && npm run test:static && npm run test:unit && npm run build:svelte && node scripts/check-bundle-size.mjs && npm run check:findings-witness && node scripts/qa-budget.mjs && npm run test:contract:smoke && npm run verify:3d-tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "sideEffects": [
    "src/lib/state/session.svelte.ts",
    "src/lib/journey/journey.ts"
  ],
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "jsdom": "^26.1.0",
    "lil-gui": "^0.21.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "spectorjs": "^0.9.30",
    "svelte": "^5.56.1",
    "svelte-check": "^4.1.0",
    "svelte-eslint-parser": "^1.8.0",
    "terser": "^5.48.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "postprocessing": "^6.39.1"
  }
}

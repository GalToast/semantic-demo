    "qa:ui-quality": "node tests/ui-quality-contract.mjs",
    "qa:micro-interactions": "node tests/micro-surface-interactions-contract.mjs",
    "qa:surface-redundancy": "node tests/surface-redundancy-contract.mjs",
    "qa:motion-state": "node tests/motion-state-contract.mjs",
    "qa:weather-widget": "node tests/weather-widget-render-contract.mjs",
    "qa:focus-stage-render": "node tests/focus-stage-render-contract.mjs",
    "qa:info-panel-collapsed": "node tests/info-panel-collapsed-render-contract.mjs",
    "qa:mobile-visual": "node tests/mobile-visual-qa-contract.mjs",
    "qa:reduced-motion-scene": "node tests/reduced-motion-scene-diagnostic.mjs",
    "qa:reduced-motion-transition": "node tests/reduced-motion-transition-contract.mjs",
    "qa:mode-chip": "node tests/mode-chip-state-render-contract.mjs",
    "qa:scene-health": "node tests/three-scene-playtest.mjs",
    "qa:adversarial": "npx playwright test tests/polish-adversarial.spec.js --browser=chromium",
    "qa:ui-renderers-seam": "npx playwright test tests/ui-renderers-validation.spec.js --browser=chromium",
    "qa:semantic-guide-fallback": "npx playwright test tests/semantic-guide-fallback-contract.spec.js --browser=chromium",
    "qa:live-reset": "npx playwright test tests/live-reset-clear-demo-proof.spec.js --browser=chromium",
    "qa:live-step-inside": "npx playwright test tests/live-step-inside-url-body-state-sync.spec.js --browser=chromium",
    "qa:live-reset-interaction": "npx playwright test tests/live-ui-reset-interaction.spec.js --browser=chromium",
    "qa:canvas-hit-test": "npx playwright test tests/canvas-hit-test-interaction.spec.js --browser=chromium",
    "qa:search-peek": "node tests/search-peek-expanded-render-contract.mjs",
    "report:artifacts": "node scripts/report-artifact-volume.js",
    "refresh:cache": "node tests/cache-buster-check.js --fix",
    "build": "esbuild js/modules/app.js --bundle --minify --keep-names --outfile=dist/bundle.js --target=es2020 --format=esm --external:three --external:three/*",
    "watch": "esbuild js/modules/app.js --bundle --outfile=dist/bundle.js --watch --target=es2020 --format=esm --external:three --external:three/*",
    "serve": "python -m http.server 8795 --bind 127.0.0.1",
    "test": "npm run check:shell && npm run check:manifest && npm run check:cache && npm run check:ownership",
    "test:fast": "npm run test",
    "test:contract": "node tests/run-all-contracts.js",
    "test:contract:core": "node tests/run-all-contracts.js --group=core",
    "test:contract:navigation": "node tests/run-all-contracts.js --group=navigation",
    "test:contract:scene": "node tests/run-all-contracts.js --group=scene",
    "test:contract:3d-interaction-quality": "node tests/run-all-contracts.js --group=3d-interaction-quality",
    "test:contract:3d-pointer": "node tests/run-all-contracts.js --group=3d-pointer",
    "test:contract:3d-visual-quality": "node tests/run-all-contracts.js --group=3d-visual-quality",
    "test:contract:3d-resilience": "node tests/run-all-contracts.js --group=3d-resilience",
    "test:contract:3d-state-data": "node tests/run-all-contracts.js --group=3d-state-data",
    "test:contract:3d-accessibility-fallback-performance": "node tests/run-all-contracts.js --group=3d-accessibility-fallback-performance",
    "test:contract:3d-focus-desktop-click": "node tests/run-all-contracts.js --group=3d-focus-desktop-click",
    "test:contract:3d-focus-neighborhood": "node tests/run-all-contracts.js --group=3d-focus-neighborhood",
    "test:contract:3d-focus-neighborhood-geometry": "node tests/run-all-contracts.js --group=3d-focus-neighborhood-geometry",
    "test:contract:3d-focus-neighborhood-interaction": "node tests/run-all-contracts.js --group=3d-focus-neighborhood-interaction",
    "test:contract:3d-focus-pocket-geometry": "node tests/run-all-contracts.js --group=3d-focus-pocket-geometry",
    "test:contract:3d-hover-click-interaction": "node tests/run-all-contracts.js --group=3d-hover-click-interaction",
    "test:contract:3d-responsive-ui": "node tests/run-all-contracts.js --group=3d-responsive-ui",
    "test:contract:3d-smoke": "node tests/run-all-contracts.js --group=3d-smoke",
    "test:contract:3d-slow": "node tests/run-all-contracts.js --group=3d-slow",
    "test:contract:3d-full": "node tests/run-all-contracts.js --group=3d-full",
    "test:contract:smoke": "node tests/run-all-contracts.js --group=smoke",
    "test:contract:motion": "node tests/run-all-contracts.js --group=motion",
    "test:contract:lifecycle": "node tests/run-all-contracts.js --group=lifecycle",
    "test:contract:browser": "node tests/run-all-contracts.js --group=browser",
    "test:contract:browser-interaction": "node tests/run-all-contracts.js --group=browser-interaction",
    "test:contract:render": "node tests/run-all-contracts.js --group=render",
    "test:contract:quality": "node tests/run-all-contracts.js --group=quality",
    "test:contract:mobile-critical": "node tests/run-all-contracts.js --group=mobile-critical",
    "test:contract:full": "node tests/run-all-contracts.js --group=full",
    "test:contract:phase-a": "node tests/surface-contract-check.mjs --surfaces=info-panel-empty,compass-rail,loading-overlay,mode-grid",
    "test:contract:phase-b": "node tests/surface-contract-check.mjs --surfaces=filters,thread-inspector,controls,search-chrome,info-panel-populated",
    "test:all": "npm run test:fast && npm run test:contract && npm run test:e2e:click-flow",
    "test:help": "node -e \"console.log('npm run test       - fast static checks (shell, cache, ownership)\\nnpm run test:fast   - alias for test\\nnpm run test:contract - Node contracts for semantic-dive-ui, search-state, camera-controls, focus-pocket, journey/event-bindings, micro-demo, cluster-labels, journey/thread-inspector\\nnpm run test:all   - fast + contract + e2e click flow\\n')\"",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "deploy:dryrun": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -DryRun",
    "test:e2e:click-flow": "npx playwright test tests/e2e-click-flow.spec.js --browser=chromium",
    "test:microdemo": "node tests/micro-demo-verify.js",
    "test:microdemo:server": "npx playwright test tests/micro-demo.spec.js --browser=chromium",
    "capture:visual": "node tests/visual-state-audit.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "three": "^0.184.0"
  }

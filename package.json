{
  "name": "semantic-explorer",
  "version": "1.0.0",
  "description": "3D semantic business explorer for Montgomery County records.",
  "main": "eslint.config.js",
  "type": "module",
  "scripts": {
    "lint": "eslint js/ js/modules/ --ext .js",
    "lint:fix": "eslint js/ js/modules/ --ext .js --fix",
    "format": "prettier --write \"js/**/*.{js,css}\"",
    "check:shell": "node tests/shell-contract-check.js",
    "check:manifest": "node tests/css-manifest-contract.mjs",
    "check:cache": "node tests/cache-buster-check.js",
    "check:ownership": "node tests/css-ownership-check.mjs",
    "qa:visual": "node tests/visual-state-audit.mjs",
    "qa:surface": "node tests/visual-state-audit.mjs",
    "qa:surface:mobile-idle": "node tests/visual-state-audit.mjs --states=01-mobile-idle",
    "qa:surface:desktop-idle": "node tests/visual-state-audit.mjs --states=07-desktop-idle",
    "qa:surface:search-error": "node tests/visual-state-audit.mjs --states=10-mobile-search-error-state",
    "qa:surface:map-trail": "node tests/visual-state-audit.mjs --states=11-mobile-selected-card-map-trail",
    "qa:surface:focus": "node tests/visual-state-audit.mjs --states=03-mobile-focus-first-result,04-mobile-field-node-active",
    "qa:surface:reduced-motion": "node tests/visual-state-audit.mjs --states=12-desktop-reduced-motion",
    "qa:surface:all": "node tests/visual-state-audit.mjs",
    "qa:contract": "node tests/surface-contract-check.mjs",
    "qa:contract:mobile-idle": "node tests/surface-contract-check.mjs --surface=mobile-idle",
    "qa:contract:desktop-idle": "node tests/surface-contract-check.mjs --surface=desktop-idle",
    "qa:contract:launch-focus": "node tests/surface-contract-check.mjs --surface=launch-focus",
    "qa:contract:search-error": "node tests/surface-contract-check.mjs --surface=search-error",
    "qa:contract:map-trail": "node tests/surface-contract-check.mjs --surface=map-trail",
    "qa:contract:focus-pocket": "node tests/surface-contract-check.mjs --surface=focus-pocket",
    "qa:contract:field-node": "node tests/surface-contract-check.mjs --surface=field-node",
    "qa:contract:info-panel-empty": "node tests/surface-contract-check.mjs --surface=info-panel-empty",
    "qa:contract:compass-rail": "node tests/surface-contract-check.mjs --surface=compass-rail",
    "qa:contract:loading-overlay": "node tests/surface-contract-check.mjs --surface=loading-overlay",
    "qa:contract:mode-grid": "node tests/surface-contract-check.mjs --surface=mode-grid",
    "qa:contract:phase-a": "node tests/surface-contract-check.mjs --surfaces=info-panel-empty,compass-rail,loading-overlay,mode-grid",
    "qa:contract:mobile-critical": "node tests/surface-contract-check.mjs --surfaces=mobile-idle,search-chrome,focus-pocket,map-trail,controls,field-node,compass-rail,global-spacing",
    "qa:contract:mobile-chrome": "node tests/surface-contract-check.mjs --surface=search-chrome",
    "qa:contract:filters": "node tests/surface-contract-check.mjs --surface=filters",
    "qa:contract:thread-inspector": "node tests/surface-contract-check.mjs --surface=thread-inspector",
    "qa:contract:controls": "node tests/surface-contract-check.mjs --surface=controls",
    "qa:contract:search-chrome": "node tests/surface-contract-check.mjs --surface=search-chrome",
    "qa:contract:info-panel-populated": "node tests/surface-contract-check.mjs --surface=info-panel-populated",
    "qa:contract:phase-b": "node tests/surface-contract-check.mjs --surfaces=filters,thread-inspector,controls,search-chrome,info-panel-populated",
    "qa:contract:global-spacing": "node tests/surface-contract-check.mjs --surface=global-spacing",
    "qa:contract:all": "node tests/surface-contract-check.mjs --surfaces=mobile-idle,desktop-idle,launch-focus,search-error,map-trail,focus-pocket,field-node,info-panel-empty,compass-rail,loading-overlay,mode-grid,filters,thread-inspector,controls,search-chrome,info-panel-populated,global-spacing",
    "qa:ui-quality": "node tests/ui-quality-contract.mjs",
    "qa:micro-interactions": "node tests/micro-surface-interactions-contract.mjs",
    "qa:surface-redundancy": "node tests/surface-redundancy-contract.mjs",
    "qa:motion-state": "node tests/motion-state-contract.mjs",
    "refresh:cache": "node tests/cache-buster-check.js --fix",
    "build": "esbuild js/modules/app.js --bundle --minify --keep-names --outfile=dist/bundle.js --target=es2020 --format=esm --external:three --external:three/*",
    "watch": "esbuild js/modules/app.js --bundle --outfile=dist/bundle.js --watch --target=es2020 --format=esm --external:three --external:three/*",
    "serve": "python -m http.server 8795 --bind 127.0.0.1",
    "test": "npm run check:shell && npm run check:manifest && npm run check:cache && npm run check:ownership",
    "test:fast": "npm run test",
    "test:contract": "node tests/semantic-dive-ui-surface-contract.mjs && node tests/search-state-surface-contract.mjs && node tests/lifecycle-composition-contract.mjs && node tests/journey-compass-state-contract.mjs && node tests/semantic-lane-contract.mjs && node tests/camera-controls-motion-contract.mjs && node tests/focus-pocket-motion-contract.mjs && node tests/journey-event-bindings-contract.mjs && node tests/micro-demo-contract.mjs && node tests/demo-init-seam-contract.mjs && node tests/demo-camera-retirement-contract.mjs && node tests/cluster-labels-contract.mjs && node tests/journey-thread-inspector-contract.mjs && node tests/trail-review-focus-contract.mjs && node tests/share-view-clipboard-contract.mjs && node tests/keyboard-help-aria-contract.mjs && node tests/pathfinding-contract.mjs && node tests/weather-lifecycle-contract.mjs && node tests/camera-auto-rotate-settle-contract.mjs && node tests/semantic-dive-reverse-contract.mjs && node tests/journey-window-surface-contract.mjs && node tests/loading-ui-contract.mjs && node tests/exploration-modes-contract.mjs && node tests/scene-reveal-contract.mjs && node tests/scene-atmosphere-contract.mjs && node tests/motion-state-contract.mjs",
    "test:all": "npm run test:fast && npm run test:contract && npm run test:e2e:click-flow",
    "test:help": "node -e \"console.log('npm run test       - fast static checks (shell, cache, ownership)\\nnpm run test:fast   - alias for test\\nnpm run test:contract - Node contracts for semantic-dive-ui, search-state, camera-controls, focus-pocket, journey/event-bindings, micro-demo, cluster-labels, journey/thread-inspector\\nnpm run test:all   - fast + contract + e2e click flow\\n')\"",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "deploy:dryrun": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -DryRun",
    "test:e2e:click-flow": "npx playwright test tests/e2e-click-flow.spec.js --browser=chromium",
    "test:microdemo": "node tests/micro-demo-verify.js",
    "test:microdemo:server": "npx playwright test tests/micro-demo.spec.js --browser=chromium",
    "capture:visual": "node tests/visual-state-audit.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.40.0",
    "prettier": "^3.8.3",
    "three": "^0.180.0"
  }
}

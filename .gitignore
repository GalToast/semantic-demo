# QA sweep artifacts
semantic-sweep-*

# Qwen worker runtime logs and caches (deeply nested bun cache exceeds Windows MAX_PATH)
.qwen/worker-logs/
.qwen/skills/

# Subagent scratch (switchboard / external-subagents / qwen / minimax runtimes drop
# runtime artifacts here: metadata.json, prompt.txt, stderr/stdout.log, vendor bins).
.agents/

# Svelte/Vite build artifacts
dist/svelte/
# Stale misconfigured build output (vite outDir relative to src/ when
# root: 'src' is set). The canonical build is dist/svelte/ above. Anything
# under src/dist/ is from a stale build and should not be tracked.
src/dist/

# Lockfiles (npm is canonical; bun.lock is local-only)
bun.lock

# PID files
*.pid

# OS / Editor noise (supplementary)
.editorconfig
.vscode/
.idea/

# Temporary directories at root
None/

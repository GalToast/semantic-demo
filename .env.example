# Deployment configuration for Semantic Explorer.
# Copy this file to .env and fill in deployment values.
# .env is gitignored; do not commit it.

# SSH host alias from ~/.ssh/config, or a user@host target.
DEPLOY_SSH_TARGET=your-ssh-alias-or-user-at-host

# SSH port for deploy commands.
DEPLOY_PORT=22

# Remote deploy directory (semantic-demo root on the server).
DEPLOY_REMOTE_DIR=/home/your-user/domains/your-domain.com/public_html/semantic-demo

# Remote domain root (public_html on the server).
DEPLOY_REMOTE_ROOT=/home/your-user/domains/your-domain.com/public_html

# API service topology overrides (used by api/config.php).
# SEMANTIC_SERVICE_HOME=/home/your-user
# SEMANTIC_SEARCH_PORT=8020
# EMBED_SERVICE_PORT=8019
# ASK_MOCO_PORT=8008

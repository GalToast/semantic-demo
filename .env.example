# Deployment configuration for Semantic Explorer.
# Copy this file to .env and fill in deployment values.
# .env is gitignored; do not commit it.

# ---------------------------------------------------------------------------
# Deploy topology (used by deploy.sh and deploy.ps1)
# ---------------------------------------------------------------------------

# SSH host alias from ~/.ssh/config, or a user@host target.
DEPLOY_SSH_TARGET=your-ssh-alias-or-user-at-host

# SSH port for deploy commands.
DEPLOY_PORT=22

# Remote deploy directory (semantic-demo root on the server).
DEPLOY_REMOTE_DIR=/home/your-user/domains/your-domain.com/public_html/semantic-demo

# Remote domain root (public_html on the server).
DEPLOY_REMOTE_ROOT=/home/your-user/domains/your-domain.com/public_html

# Domain target for scp (ssh-target:/remote-dir/).
# Only needed if DEPLOY_SSH_TARGET and DEPLOY_REMOTE_DIR are not enough.
# DEPLOY_DOMAIN_TARGET=your-ssh-alias:/home/your-user/domains/your-domain.com/public_html/semantic-demo/

# Backup directory (outside public_html so backups are never web-accessible).
# Default: /home/u741831384/backups/semantic-demo
# DEPLOY_BACKUP_DIR=/home/your-user/backups/semantic-demo

# ---------------------------------------------------------------------------
# API service topology (used by api/config.php)
# ---------------------------------------------------------------------------

# Base home directory for scripts, state, and cache files.
# Default: /home/u741831384 (mccullough-cloud production)
# SEMANTIC_SERVICE_HOME=/home/your-user

# Service health-check ports (default 8020 / 8019 / 8008).
# These control the port in the auto-built health URLs.
# SEMANTIC_SEARCH_PORT=8020
# EMBED_SERVICE_PORT=8019
# ASK_MOCO_PORT=8008

# Full health/ask URL overrides (bypass the port-based defaults).
# SEMANTIC_SEARCH_HEALTH_URL=http://127.0.0.1:8020/healthz
# EMBED_SERVICE_HEALTH_URL=http://127.0.0.1:8019/healthz
# ASK_MOCO_HEALTH_URL=http://127.0.0.1:8008/healthz
# ASK_MOCO_ASK_URL=http://127.0.0.1:8008/ask

# Script path overrides (default: $SEMANTIC_SERVICE_HOME/bin/<script>).
# SEMANTIC_SEARCH_START_SCRIPT=/path/to/start-public-semantic-search
# EMBED_SERVICE_START_SCRIPT=/path/to/start-qwen-embed-service
# ASK_MOCO_START_SCRIPT=/path/to/start-ask-moco-service
# SEMANTIC_GUIDE_WORKER_SCRIPT=/path/to/run-semantic-guide-worker

# State file path overrides (default: $SEMANTIC_SERVICE_HOME/ai/<file>).
# SEMANTIC_SEARCH_STATE_FILE=/path/to/public_semantic_search.state.json
# EMBED_SERVICE_STATE_FILE=/path/to/qwen_embed_service.state.json
# SEMANTIC_LANE_STATE_FILE=/path/to/semantic_lane_state.json

# Cache directory overrides (default: $SEMANTIC_SERVICE_HOME/ai/<dir>).
# SEMANTIC_SEARCH_CACHE_DIR=/path/to/semantic_search_cache
# SEMANTIC_GUIDE_CACHE_DIR=/path/to/semantic_guide_cache
# SEMANTIC_GUIDE_JOB_DIR=/path/to/semantic_guide_jobs
# SEMANTIC_GEMMA_CACHE_DIR=/path/to/semantic_gemma_cache

# Cache tuning (seconds / milliseconds).
# SEMANTIC_SEARCH_CACHE_TTL_SECONDS=21600
# SEMANTIC_SEARCH_CACHE_WAIT_MS=1800
# SEMANTIC_GUIDE_CACHE_TTL_SECONDS=21600
# SEMANTIC_GUIDE_CACHE_WAIT_MS=1800
# SEMANTIC_GEMMA_STORY_CACHE_TTL_SECONDS=604800

# Lane watchdog / recovery.
# SEMANTIC_LANE_EVENT_LOG=/path/to/semantic_lane_events.log
# SEMANTIC_LANE_WATCHDOG_LOG=/path/to/semantic_lane_watchdog.log
# SEMANTIC_LANE_RESTART_COOLDOWN_SECONDS=45
# SEMANTIC_LANE_RECOVERY_FRESH_SECONDS=90
# SEMANTIC_LANE_HEALTH_PROBE_RESTARTS_ENABLED=false

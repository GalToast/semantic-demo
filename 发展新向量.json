{
        "name": "semantic-explorer",
        "version": "1.0.0",
        "description": "3D semantic business explorer for Montgomery County records.",
        "main": "eslint.config.js",
        "type": "module",
        "scripts": {
                "lint": "eslint \"{js,tests}/**/*.{js,ts}\" && eslint \"src/**/*.{ts,svelte}\" --max-warnings=9999",
                "lint:fix": "eslint \"{js,tests}/**/*.{js,ts}\" --fix && eslint \"src/**/*.{ts,svelte}\" --fix --max-warnings=9999",
                "lint:tests": "eslint \"tests/**/*.{js,ts}\" --no-warn-ignored",
                "lint:src": "eslint \"src/**/*.{ts,svelte}\"",
                "lint:all": "npm run lint",
                "audit:a11y": "node scripts/audit-a11y.mjs",
                "audit:a11y:strict": "node scripts/audit-a11y.mjs --strict",
                "audit:a11y:json": "node scripts/audit-a11y.mjs --json",
                "lint:nav-mirror": "node scripts/ci-check-nav-mirror-pattern.mjs",
                "lint:svelte5-strict-mode": "node scripts/ci-check-svelte5-strict-mode.mjs",
                "sg": "ast-grep",
                "mcp:recover": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mcp-recover.ps1",
                "mcp:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/browser-mcp-doctor.ps1",
                "skill:doctor": "pwsh -NoLogo -NoProfile -File scripts/skill-doctor.ps1",
                "model:health": "node scripts/model-health-check.mjs",
                "model:health:smoke": "node scripts/model-health-check.mjs --smoke",
                "model:health:logfare": "node scripts/model-health-check.mjs --provider=logfare --smoke",
                "model:health:kimi": "node scripts/model-health-check.mjs --provider=logfare --limit=4",
                "format": "prettier --write \"{js,tests}/**/*.{js,ts,css}\"",
                "check:shell": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/shell-contract-check.js",
                "check:manifest": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-manifest-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/package-script-targets-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-self-reference-check.mjs",
                "check:script-targets": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/package-script-targets-contract.mjs",
                "check:no-self-refs": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-self-reference-check.mjs",
                "check:cache": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/cache-buster-check.js",
                "check:config-topology": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/config-topology-env-contract.mjs",
                "check:ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-ownership-check.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/focus-stage-css-ownership-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/css-transient-state-ownership-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/composition-state-owner-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/map-focus-search-content-owner-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/search-sheet-css-ownership-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/mobile-chrome-ownership-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/info-panel-surface-ownership-contract.mjs",
                "check:tokens": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/design-token-doc-contract.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/js-design-token-contract.mjs",
                "check:surface-styles": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-style-matrix-contract.mjs",
                "check:css-minified": "node tests/css-minification-build-output-contract.mjs",
                "check:semantic-space": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/semantic-space-audit.mjs && node --loader ./tests/helpers/ts-resolve-loader.mjs tests/semantic-thread-relationship-role-contract.mjs",
                "check:svelte": "svelte-check --workspace src --tsconfig tsconfig.json --diagnostic-sources svelte,css",
                "check": "npm run check:svelte && npm run build:svelte",
                "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
                "check:ts-progress": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/ts-js-drift-contract.mjs --progress",
                "check:legacy-budget": "node scripts/check-legacy-ts-budget.mjs",
                "build:safe": "npm run check",
                "qa:server": "node scripts/qa-server.mjs start",
                "qa:server:ensure": "node scripts/qa-server.mjs ensure",
                "qa:server:stop": "node scripts/qa-server.mjs stop",
                "qa:server:status": "node scripts/qa-server.mjs status",
                "qa:visual": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/visual-state-audit.mjs --headed",
                "qa:desktop-critical": "node scripts/qa.mjs visual --states=07-desktop-idle,08-desktop-search-coffee,11-desktop-selected-card-map-trail,12-desktop-reduced-motion,13-desktop-filters-open,14-desktop-search-error,16-desktop-info-panel-populated --headed && node scripts/qa.mjs contract --surfaces=desktop-idle,info-panel-populated --headed",
                "qa:focus-readability": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/focus-camera-readability-contract.mjs",
                "qa:camera-ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/focus-camera-ownership-contract.mjs",
                "qa:interaction-ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/focus-interaction-ownership-contract.mjs",
                "qa:mobile-route-ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/mobile-route-ownership-contract.mjs",
                "qa:reset-map-ownership": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/reset-map-interaction-ownership-contract.mjs",
                "qa:product-playthrough": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/product-playthrough-audit.mjs --headed",
                "qa:real-route:visual": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/product-playthrough-audit.mjs --real-route-visual --headed",
                "qa:route-ergonomics": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/product-playthrough-audit.mjs --real-route-visual --visual-ergonomics --headed",
                "qa:release-mobile-ownership": "npm run qa:ui-quality && node scripts/qa.mjs visual --states=11-mobile-selected-card-map-trail,24-mobile-map-focus-search,17-mobile-thread-inspector --headed && npm run qa:product-playthrough && npm run check:script-targets",
                "qa:release-mobile-ownership:headed": "npm run qa:ui-quality && node scripts/qa.mjs visual --states=11-mobile-selected-card-map-trail,24-mobile-map-focus-search,17-mobile-thread-inspector --headed && node scripts/qa.mjs playthrough --real-route-visual --headed && npm run check:script-targets",
                "qa:short-landscape": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/short-landscape-layout-contract.mjs && npx playwright test tests/short-landscape-contract.spec.js --browser=chromium --headed",
                "qa:short-landscape:transition": "npx playwright test tests/short-landscape-transition-ui-paths.spec.js --browser=chromium --workers=1 --headed",
                "qa:short-landscape:release": "npm run qa:short-landscape && npm run qa:short-landscape:transition",
                "qa:contract": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-contract-check.mjs --headed",
                "qa:contract:mobile-critical": "node scripts/qa.mjs contract --preset=mobile-critical --headed",
                "qa:contract:phase-a": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-contract-check.mjs --surfaces=info-panel-empty,compass-rail,loading-overlay,mode-grid --headed",
                "qa:contract:phase-b": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-contract-check.mjs --surfaces=filters,thread-inspector,controls,search-chrome,search-no-results,info-panel-populated --headed",
                "qa:ui-quality": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/ui-quality-contract.mjs --headed",
                "qa:micro-interactions": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/micro-surface-interactions-contract.mjs",
                "qa:surface-redundancy": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/surface-redundancy-contract.mjs",
                "qa:motion-state": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/motion-state-contract.mjs",
                "qa:weather-widget": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/weather-widget-render-contract.mjs",
                "qa:focus-stage-render": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/focus-stage-render-contract.mjs",
                "qa:info-panel-collapsed": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/info-panel-collapsed-render-contract.mjs",
                "qa:mobile-visual": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/mobile-visual-qa-contract.mjs",
                "qa:reduced-motion-scene": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/reduced-motion-scene-diagnostic.mjs",
                "qa:reduced-motion-transition": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/reduced-motion-transition-contract.mjs",
                "qa:mode-chip": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/mode-chip-state-render-contract.mjs",
                "qa:scene-health": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/three-scene-playtest.mjs",
                "qa:focus-semantic-line": "npx playwright test tests/focus-semantic-line-contract.spec.js --browser=chromium --headed",
                "qa:role-traversal": "npx playwright test tests/semantic-role-traversal.spec.js --browser=chromium --workers=1 --headed",
                "qa:adversarial": "npx playwright test tests/polish-adversarial.spec.js --browser=chromium --headed",
                "qa:ui-renderers-seam": "npx playwright test tests/ui-renderers-validation.spec.js --browser=chromium --headed",
                "qa:semantic-guide-fallback": "npx playwright test tests/semantic-guide-fallback-contract.spec.js --browser=chromium --headed",
                "qa:live-reset": "npx playwright test tests/live-reset-clear-demo-proof.spec.js --browser=chromium --headed",
                "qa:journey": "npx playwright test tests/widget-journey.spec.js --browser=chromium --headed",
                "qa:journey:headless": "npx playwright test tests/widget-journey.spec.js --browser=chromium",
                "qa:live-step-inside": "npx playwright test tests/live-step-inside-url-body-state-sync.spec.js --browser=chromium --headed",
                "qa:live-reset-interaction": "npx playwright test tests/live-ui-reset-interaction.spec.js --browser=chromium --headed",
                "qa:live-semantic-roles": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/live-semantic-roles-contract.mjs",
                "qa:canvas-hit-test": "npx playwright test tests/canvas-hit-test-interaction.spec.js --browser=chromium --headed",
                "qa:search-peek": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/search-peek-expanded-render-contract.mjs",
                "report:artifacts": "node scripts/report-artifact-volume.js",
                "prune:artifacts": "node scripts/report-artifact-volume.js --prune-dry-run",
                "prune:artifacts:now": "node scripts/report-artifact-volume.js --prune-dry-run --execute --yes",
                "refresh:cache": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/cache-buster-check.js --fix",
                "build": "npm run build:svelte",
                "watch": "vite build --config vite.config.ts --watch",
                "serve": "python -m http.server 8795 --bind 127.0.0.1",
                "check:bridges": "node scripts/check-bridge-references.mjs",
                "test:static": "npm run check:shell && npm run check:manifest && npm run check:cache && npm run check:config-topology && npm run check:bridges && npm run check:ownership && npm run check:tokens && npm run check:surface-styles && npm run check:semantic-space && npm run typecheck",
                "test": "npm run test:static && npm run test:unit",
                "test:fast": "npm run test:static",
                "test:contract": "node tests/run-all-contracts.js",
                "test:contract:core": "node tests/run-all-contracts.js --group=core",
                "test:contract:smoke": "node tests/run-all-contracts.js --group=smoke",
                "test:contract:full": "node tests/run-all-contracts.js --group=full",
                "test:stress": "playwright test tests/heavy-stress-leak.spec.js --browser=chromium",
                "test:unit": "vitest run --config vitest.config.js",
                "test:unit:watch": "vitest --config vitest.config.js",
                "test:coverage": "vitest run --config vitest.config.js --coverage",
                "test:help": "node -e \"console.log('Available test commands:\n  npm run test          - static checks + unit tests\n  npm run test:fast     - alias for test:static\n  npm run test:unit     - Vitest unit tests\n  npm run test:contract - Node contract runner (all groups)\n  npm run test:ci       - fast + unit + contract + e2e click flow (no stress)\n  npm run test:all      - ci + stress test (120s)\n  npm run test:stress   - heavy load + WebGL leak detection (120s)\n  npm run test:smoke    - quick smoke checks (weather, scene, loading)\n  npm run test:contract:core|smoke|full  - specific groups')\"",
                "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
                "deploy:dryrun": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -DryRun",
                "test:visual": "npx tsx tests/visual-regression.test.ts",
                "test:visual:update": "UPDATE_SNAPSHOTS=true npx playwright test tests/integration/visual-state-snapshots.spec.js --browser=chromium --timeout=60000",
                "test:a11y": "playwright test tests/integration/a11y-baseline.spec.js --browser=chromium",
                "test:e2e:click-flow": "npx playwright test tests/e2e-click-flow.spec.js --browser=chromium --headed",
                "test:svelte-migration": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/verify-svelte-migration.mjs",
                "test:microdemo": "node --loader ./tests/helpers/ts-resolve-loader.mjs tests/micro-demo-verify.js",
                "test:microdemo:server": "npx playwright test tests/micro-demo.spec.js --browser=chromium --headed",
                "dev:svelte": "vite --config vite.config.ts",
                "build:svelte": "vite build --config vite.config.ts",
                "preview:svelte": "vite preview --config vite.config.ts",
                "git:hook:check": "node -e \"const {execSync}=require('child_process');const p=require('path');process.platform==='win32'?execSync('pwsh -NoLogo -NoProfile -File '+p.join('scripts','git-hooks','pre-commit.ps1')+' --AllowAnyBranch --SkipHighRiskCheck',{stdio:'inherit'}):execSync('bash '+p.join('scripts','git-hooks','pre-commit')+' --AllowAnyBranch --SkipHighRiskCheck',{stdio:'inherit'})\"",
                "git:hook:install": "pwsh -NoLogo -NoProfile -Command \"Copy-Item -Path 'scripts/git-hooks/pre-commit' -Destination '.git/hooks/pre-commit' -Force; Copy-Item -Path 'scripts/git-hooks/pre-commit.ps1' -Destination '.git/hooks/pre-commit.ps1' -Force; Copy-Item -Path 'scripts/git-hooks/pre-commit.cmd' -Destination '.git/hooks/pre-commit.cmd' -Force; Write-Host 'Git pre-commit hook installed (bash + ps1 shim + cmd wrapper).'\"",
                "git:hook:uninstall": "pwsh -NoLogo -NoProfile -Command \"Remove-Item -Path '.git/hooks/pre-commit' -Force -ErrorAction SilentlyContinue; Remove-Item -Path '.git/hooks/pre-commit.ps1' -Force -ErrorAction SilentlyContinue; Remove-Item -Path '.git/hooks/pre-commit.cmd' -Force -ErrorAction SilentlyContinue; Write-Host 'Git pre-commit hook removed.'\"",
                "test:ci": "npm run test:fast && npm run test:unit && npm run test:contract && npm run test:e2e:click-flow",
                "test:all": "npm run test:ci && npm run test:stress"
        },
        "keywords": [],
        "author": "",
        "license": "ISC",
        "sideEffects": [
        "src/lib/state/session.svelte.ts"
    ],
        "devDependencies": {
                "@ast-grep/cli": "^0.43.0",
                "@axe-core/playwright": "^4.11.3",
                "@eslint/js": "^10.0.1",
                "@playwright/test": "^1.60.0",
                "@sveltejs/vite-plugin-svelte": "^7.1.2",
                "@testing-library/svelte": "^5.3.1",
                "@types/node": "^25.9.3",
                "@types/three": "^0.184.0",
                "@vitest/coverage-v8": "^4.1.9",
                "eslint": "^10.4.1",
                "eslint-config-prettier": "^10.1.8",
                "jsdom": "^29.1.1",
                "lil-gui": "^0.21.0",
                "pixelmatch": "^7.2.0",
                "playwright": "^1.60.0",
                "pngjs": "^7.0.0",
                "prettier": "^3.8.3",
                "rollup-plugin-visualizer": "^7.0.1",
                "spectorjs": "^0.9.30",
                "svelte": "^5.56.1",
                "svelte-check": "^4.1.0",
                "terser": "^5.48.0",
                "three": "^0.184.0",
                "typescript": "^6.0.3",
                "vitest": "^4.1.7"
        },
        "dependencies": {
                "postprocessing": "^6.39.1"
        }
}
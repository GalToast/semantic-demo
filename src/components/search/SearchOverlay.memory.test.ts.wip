import { describe, test, expect, beforeAll, afterAll } from "bun:test";
import { mount, unmount } from "svelte";
import SearchOverlay from "./SearchOverlay.svelte";
import { QueryCache } from "./search-store";

describe("SearchOverlay memory", () => {
  let container: HTMLDivElement;

  beforeAll(() => {
    container = document.createElement("div");
    document.body.appendChild(container);
  });

  afterAll(() => {
    container.remove();
    // @ts-expect-error
    window.__sv__clear__?.();
  });

  test("frees on destroy", () => {
    const props = { onClose: () => {}, queryCache: new QueryCache() };
    const app = mount(SearchOverlay, { target: container, props });
    unmount(app);

    expect(document.querySelector("[data-search-overlay]")).toBeNull();
  });
});
